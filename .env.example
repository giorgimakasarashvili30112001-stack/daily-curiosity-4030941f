# ============================================================================
# The Daily How — ONE configuration file.
# Copy to `.env` and fill in. `.env` is gitignored: never commit real secrets.
# Everything reads from here: the web app, the server, the native widgets, the
# Capacitor shell, the daily-scheduler SQL and the Supabase CLI config.
#
# After editing, run `npm run config:sync` to regenerate the files that can't
# read .env directly (widgets, scheduler SQL). Rebuild the web app after
# changing SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY (they are baked into the
# browser bundle at build time).
# ============================================================================

# --- Your deployed site (https, no trailing slash) --------------------------
# Used by: native widgets, Capacitor shell, daily scheduler SQL.
APP_URL=https://your-domain.example.com

# --- Supabase ---------------------------------------------------------------
# URL + publishable (anon) key are public by design; RLS protects the data.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# SECRET. Bypasses RLS. Server-only; never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (Google Gemini, used for explainers and quiz questions) --------------
# SECRET.
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-flash-latest

# --- Scheduler --------------------------------------------------------------
# SECRET. Bearer token accepted by /api/public/prewarm.
# Generate one with: openssl rand -hex 32
PREWARM_SECRET=long-random-string

# --- Build ------------------------------------------------------------------
# Nitro deploy preset. Default: node-server. Others: vercel, netlify, cloudflare-module
# NITRO_PRESET=node-server
