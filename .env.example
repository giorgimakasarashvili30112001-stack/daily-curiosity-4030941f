# Copy to .env (local) or set these in your hosting provider. Never commit real secrets.

# --- Supabase (server) ---------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose to the browser

# --- Supabase (browser bundle, injected at build time) -------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# --- AI (facts + quiz generation, Google Gemini) -------------------------
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-flash-latest

# --- Scheduler -----------------------------------------------------------
# Bearer token accepted by /api/public/prewarm (in addition to the pg_cron token
# created by DAILY_SCHEDULER_SETUP.sql).
PREWARM_SECRET=long-random-string

# --- Build ---------------------------------------------------------------
# Nitro deploy preset. Default: node-server. Examples: vercel, netlify, cloudflare-module
# NITRO_PRESET=node-server
